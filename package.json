{
  "name": "capsule",
  "version": "0.2.0",
  "private": true,
  "description": "capsule: agent skills library",
  "license": "MIT",
  "scripts": {
    "check": "npm run test && npm run validate",
    "test": "node --test scripts/*.test.mjs",
    "validate": "node scripts/validate-repo.mjs",
    "changeset": "changeset",
    "version:skills": "changeset version && node scripts/sync-version.mjs && npm run validate"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "js-yaml": "^5.5.0"
  },
  "overrides": {
    "@changesets/parse": {
      "js-yaml": "4.3.2"
    },
    "read-yaml-file": {
      "js-yaml": "3.15.2"
    }
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sea922/capsule"
  }
}
