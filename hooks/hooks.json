{
  "description": "capsule guards: refuse git hook bypasses and edits to existing lint or format configs. Disable one with CAPSULE_HOOKS_DISABLED=<id>.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/block-no-verify.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/config-protection.mjs\"", "timeout": 10 }]
      }
    ]
  }
}
